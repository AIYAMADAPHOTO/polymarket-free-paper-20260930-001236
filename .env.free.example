# ZERO-COST PAPER BOT ONLY
# Copy this file to .env.free and fill GEMINI_API_KEY.
# IMPORTANT: create the key in a Gemini API / Google AI Studio project with billing NOT linked.
TRADING_MODE=PAPER
STARTING_BALANCE_USD=50.00
GEMINI_API_KEY=
GEMINI_BILLING_DISABLED_CONFIRMED=YES

# Current zero-cost default: free-tier model + Bot-side free public evidence feeds.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Gemini 3.x free API tier does not include Search grounding, so the bot gathers
# current evidence itself from no-key/no-charge public feeds before the model call.
GEMINI_USE_GOOGLE_SEARCH=false
# 10-minute cadence = about 144 calls/day; 200 is a hard local ceiling.
GEMINI_MAX_CALLS_PER_DAY=200

# Source-post-style settings.
FREE_SCAN_LIMIT=1000
FREE_PAGE_SIZE=100
FREE_SCAN_INTERVAL_SECONDS=600
FREEBOT_DURATION_HOURS=48
FREE_AI_CANDIDATE_LIMIT=40
FREE_EVIDENCE_CANDIDATE_LIMIT=8
FREE_EVIDENCE_CACHE_SECONDS=1800
FREE_EVIDENCE_ITEMS_PER_MARKET=6
FREE_EVIDENCE_TIMEOUT_SECONDS=12
FREE_MIN_EDGE=0.08
FREE_MAX_POSITION_FRACTION=0.06
FREE_KELLY_MULTIPLIER=1.0

# Conservative prefilter / paper risk controls.
FREE_MIN_PRICE=0.03
FREE_MAX_PRICE=0.97
FREE_MIN_VOLUME=1000
FREE_MIN_LIQUIDITY=250
FREE_MIN_REMAINING_SECONDS=3600
FREE_MIN_CONFIDENCE=0.55
FREE_MAX_EXPOSURE_FRACTION=0.30
FREE_MAX_POSITIONS=5
FREE_MIN_TRADE_USD=0.50
FREE_DAILY_LOSS_FRACTION=0.15
FREE_MARKET_COOLDOWN_SECONDS=3600
FREE_EXIT_EDGE_FLOOR=0.02
FREE_STOP_LOSS_FRACTION=0.15
FREE_TAKE_PROFIT_FRACTION=0.25
FREE_MAX_HOLDING_SECONDS=86400
FREE_RESOLUTION_EXIT_SECONDS=1800

LOG_LEVEL=INFO
TZ=Asia/Tokyo
FREEBOT_DATA_DIR=/var/lib/freebot
